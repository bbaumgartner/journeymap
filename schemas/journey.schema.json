{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bbaumgartner/journeymap/schemas/journey.schema.json",
  "title": "JourneyMap",
  "description": "Clustered journey stops used by `journeymap generate --positions`. Order is chronological route order.",
  "type": "object",
  "required": ["positions"],
  "additionalProperties": false,
  "properties": {
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "lat", "lng", "days"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO date (YYYY-MM-DD) of the stop — typically the first day at this location."
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Latitude in decimal degrees."
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Longitude in decimal degrees."
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "description": "Days spent at this stop. Drives hold length after arriving in the animation."
          }
        }
      }
    }
  }
}
